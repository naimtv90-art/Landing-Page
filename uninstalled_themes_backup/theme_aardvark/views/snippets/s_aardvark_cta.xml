            <div class="container py-lg-5 text-center">
                <div class="mx-auto" style="max-width: 720px;">
                    <img src="/theme_aardvark/static/src/img/logo-circle-big.svg" width="96" height="96" alt="Aardvark Logo" class="mb-4"/>
