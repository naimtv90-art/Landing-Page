<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_tc_products" name="Threadcraft Product Categories">
        <section class="s_tc_products oe_structure oe_empty py-5" data-name="Threadcraft Product Categories">
            <div class="container py-4">
                <!-- Section Header -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
                    <div>
                        <span class="badge rounded-pill bg-dark text-white font-mono text-uppercase px-3 py-2 mb-2">
                            Engineered Collections
                        </span>
                        <h2 class="display-5 fw-bolder text-uppercase tc-font-syne mb-0">
                            Core Apparel Silhouettes
                        </h2>
                    </div>
                    <p class="text-muted font-sans max-w-400 mb-0">
                        High-volume OEM production programs optimized for retail brands, corporate apparel, and international fashion labels.
                    </p>
                </div>

                <!-- Category Filters -->
                <div class="d-flex flex-wrap gap-2 mb-4 font-mono">
                    <button type="button" class="btn btn-dark active" data-filter="all">ALL SILHOUETTES</button>
                    <button type="button" class="btn btn-outline-dark" data-filter="tshirts">T-SHIRTS</button>
                    <button type="button" class="btn btn-outline-dark" data-filter="hoodies">HOODIES &amp; SWEATS</button>
                    <button type="button" class="btn btn-outline-dark" data-filter="polos">POLO SHIRTS</button>
                    <button type="button" class="btn btn-outline-dark" data-filter="outerwear">TECHNICAL OUTERWEAR</button>
                </div>

                <!-- Products Grid -->
                <div class="row g-4">
                    <!-- Item 1: Heavyweight Tee -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="tshirts">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 1,000 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 60 40 L 80 50 C 90 60 110 60 120 50 L 140 40 L 175 75 L 150 95 L 140 85 L 140 170 L 60 170 L 60 85 L 50 95 L 25 75 Z"/>
                                        <path d="M 80 50 C 90 60 110 60 120 50" stroke-width="2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Heavyweight Streetwear</div>
                                    <h4 class="card-title fw-bold font-sans">240 GSM Boxy Drop-Shoulder Tee</h4>
                                    <p class="card-text text-muted small font-sans">100% combed ring-spun organic cotton, pre-shrunk, twin needle stitching throughout.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">Custom Dye &amp; Wash</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 2: Fleece Hoodie -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="hoodies">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 500 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 50 50 L 75 35 C 85 45 115 45 125 35 L 150 50 L 180 90 L 155 105 L 145 95 L 145 175 L 55 175 L 55 95 L 45 105 L 20 90 Z"/>
                                        <path d="M 80 40 C 85 20 115 20 120 40" stroke-width="2"/>
                                        <path d="M 75 130 L 125 130 L 125 160 L 75 160 Z" stroke-dasharray="2 2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Premium Fleece</div>
                                    <h4 class="card-title fw-bold font-sans">420 GSM Diagonal Loop French Terry</h4>
                                    <p class="card-text text-muted small font-sans">Double-layered hood, 2x2 heavy rib cuffs, bar-tacked kangaroo pocket with custom aglets.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">Custom Pigment Wash</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 3: Pique Polo -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="polos">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 1,000 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 60 45 L 80 40 L 100 55 L 120 40 L 140 45 L 170 80 L 145 95 L 138 85 L 138 170 L 62 170 L 62 85 L 55 95 L 30 80 Z"/>
                                        <line x1="100" y1="55" x2="100" y2="100" stroke-width="2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Corporate &amp; Golf Wear</div>
                                    <h4 class="card-title fw-bold font-sans">220 GSM Honeycomb Pique Knit Polo</h4>
                                    <p class="card-text text-muted small font-sans">Flat knit collar with anti-curl tipping, genuine mother-of-pearl buttons, side seam vents.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">Mercerized Finish</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 4: Zip Jacket -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="outerwear">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 500 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 55 45 L 75 40 L 100 50 L 125 40 L 145 45 L 175 80 L 150 95 L 140 85 L 140 170 L 60 170 L 60 85 L 50 95 L 25 80 Z"/>
                                        <line x1="100" y1="50" x2="100" y2="170" stroke-width="2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Performance Shell</div>
                                    <h4 class="card-title fw-bold font-sans">Waterproof Membrane Shell Jacket</h4>
                                    <p class="card-text text-muted small font-sans">3-layer bonded technical polyester with fully taped seams and waterproof YKK Aquaguard zips.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">10,000mm Hydrostatic</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 5: Crewneck -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="hoodies">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 800 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 55 45 L 80 50 C 90 60 110 60 120 50 L 145 45 L 175 80 L 150 95 L 140 85 L 140 170 L 60 170 L 60 85 L 50 95 L 25 80 Z"/>
                                        <path d="M 85 80 L 100 100 L 115 80" stroke-width="2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Heavyweight Fleece</div>
                                    <h4 class="card-title fw-bold font-sans">380 GSM Vintage V-Insert Crewneck</h4>
                                    <p class="card-text text-muted small font-sans">Relaxed boxy cut, ribbed collar with authentic triangular gusset, heavy brushed interior.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">Garment Dyed</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 6: Oversized Vintage Tee -->
                    <div class="col-md-6 col-lg-4 tc-product-card" data-category="tshirts">
                        <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                            <div class="position-relative bg-light p-4 text-center overflow-hidden" style="height: 300px;">
                                <span class="badge bg-dark position-absolute top-0 start-0 m-3 font-mono">MOQ: 1,000 PCS</span>
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <svg viewBox="0 0 200 200" class="w-75 h-75" fill="none" stroke="#171717" stroke-width="3">
                                        <path d="M 50 40 L 75 50 C 90 60 110 60 125 50 L 150 40 L 185 80 L 160 100 L 145 88 L 145 170 L 55 170 L 55 88 L 40 100 L 15 80 Z"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="font-mono small text-muted text-uppercase mb-1">Raw Wash Collection</div>
                                    <h4 class="card-title fw-bold font-sans">280 GSM Ultra-Heavyweight Raw Tee</h4>
                                    <p class="card-text text-muted small font-sans">100% GOTS organic carded cotton, chunky 1.25" neck ribbing, seamless tubular body construction.</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-10 mt-3">
                                    <span class="font-mono fw-bold">Tubular Construction</span>
                                    <a href="/contact" class="btn btn-sm btn-outline-dark font-mono">Inquire</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
