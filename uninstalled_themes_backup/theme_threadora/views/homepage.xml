<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_threadora_homepage" inherit_id="website.homepage" name="Threadora Garments Homepage" priority="99">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="theme_threadora.s_garment_hero"/>
                <t t-call="theme_threadora.s_garment_stats"/>
                <t t-call="theme_threadora.s_garment_categories"/>
                <t t-call="theme_threadora.s_garment_products"/>
                <t t-call="theme_threadora.s_garment_collection"/>
                <t t-call="theme_threadora.s_garment_manufacturing"/>
                <t t-call="theme_threadora.s_garment_wholesale"/>
                <t t-call="theme_threadora.s_garment_private_label"/>
                <t t-call="theme_threadora.s_garment_quality"/>
                <t t-call="theme_threadora.s_garment_sustainability"/>
                <t t-call="theme_threadora.s_garment_testimonials"/>
                <t t-call="theme_threadora.s_garment_faq"/>
                <t t-call="theme_threadora.s_garment_newsletter"/>
                <t t-call="theme_threadora.s_garment_cta"/>
            </div>
        </xpath>
    </template>
</odoo>