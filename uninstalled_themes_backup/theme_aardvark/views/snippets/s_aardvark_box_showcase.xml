                    <!-- Callout for Mobile View -->
                    <div class="d-md-none text-center px-4 mb-4">
                        <p class="u-handwritten fs-4 text-dark mb-0">Each box includes a bookmark per book and postcard with a challenge to win a free credit!</p>
                    </div>

                    <!-- Bottom App Badges & Slogan -->
                    <div class="text-center pb-4 pt-2 px-3">
                        <div class="mb-3">
                            <img src="/theme_aardvark/static/src/img/box-title.svg" alt="Unbox Stories Worth Talking About" class="img-fluid" style="max-width: 680px; width: 90%; height: auto;"/>
                        </div>
                        <span class="u-handwritten fs-3 text-dark d-block mb-3">Made for readers by readers</span>
                        <div class="d-flex justify-content-center flex-wrap gap-3">
                            <a href="https://apps.apple.com" target="_blank" class="d-inline-block transition-hover">
                                <img src="/theme_aardvark/static/src/img/app-store.svg" alt="App Store" style="height: 48px;"/>
                            </a>
                            <a href="https://play.google.com" target="_blank" class="d-inline-block transition-hover">
