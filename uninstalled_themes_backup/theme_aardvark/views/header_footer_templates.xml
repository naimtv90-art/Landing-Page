<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Google Fonts injection in HEAD -->
    <template id="aardvark_google_fonts" inherit_id="web.frontend_layout" name="Aardvark Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&amp;family=Fraunces:opsz,wght@9..144,600..900&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <template id="aardvark_header_footer" inherit_id="website.layout" name="Aardvark Header &amp; Footer">
        <!-- Header Replacement -->
        <xpath expr="//header" position="replace">
            <header id="top" class="aard-header">
                <div class="container-fluid px-lg-5">
                    <div class="d-flex align-items-center justify-content-between">
                        <!-- Brand Logo -->
                        <div class="d-flex align-items-center">
                            <a href="/" class="d-inline-block text-decoration-none">
                                <img src="/theme_aardvark/static/src/img/logo.svg" alt="Aardvark Book Club Logo" height="38" class="d-inline-block align-top"/>
                            </a>
                        </div>

                        <!-- Center Navigation -->
                        <nav class="d-none d-lg-flex align-items-center gap-1">
                            <ul class="navbar-nav flex-row gap-1 align-items-center mb-0 list-unstyled">
                                <li class="nav-item">
                                    <a class="nav-link" href="/shop">All Books</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/#how-it-works">How It Works</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/gifting">Gifting</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/faq">FAQ</a>
                                </li>
                            </ul>
                        </nav>

                        <!-- Right Actions -->
                        <div class="d-flex align-items-center gap-2 gap-md-3">
                            <a href="https://www.aardvarkbookclub.co.uk/" target="_blank" class="aard-header-sub d-none d-xl-inline-flex">
                                <span>🇬🇧 Shopping from UK?</span>
                            </a>
                            
                            <!-- Instagram Icon -->
                            <a href="https://instagram.com/aardvarkbookclub" target="_blank" class="d-none d-md-inline-flex align-items-center justify-content-center text-dark rounded-circle border border-2 border-dark" style="width:38px; height:38px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>

                            <!-- Login Button -->
                            <a href="/web/login" class="aard-button-alt">
                                <span class="btn-pill-text py-2 px-3 small">Log-in / Sign-up</span>
                                <span class="btn-pill-arrow" style="width:36px; height:36px;">➔</span>
                            </a>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>

        <!-- Footer Replacement -->
        <xpath expr="//footer" position="replace">
            <footer id="bottom" class="aard-footer">
                <div class="container pb-5">
                    <div class="row g-5">
                        <!-- Brand Column -->
                        <div class="col-lg-4">
                            <div class="mb-4">
                                <img src="/theme_aardvark/static/src/img/logo.svg" alt="Aardvark Logo" height="42" class="mb-3" style="filter: brightness(0) invert(1);"/>
                                <p class="text-white-50 fs-6" style="line-height: 1.6;">
                                    The book club that’s anything but traditional. Pick up to 3 gorgeous new-release hardcovers every month, delivered right to your door.
                                </p>
                            </div>
                            <div class="d-flex gap-3">
                                <a href="https://apps.apple.com" target="_blank">
                                    <img src="/theme_aardvark/static/src/img/app-store.svg" alt="App Store" style="height: 40px;"/>
                                </a>
                                <a href="https://play.google.com" target="_blank">
                                    <img src="/theme_aardvark/static/src/img/google-play.svg" alt="Google Play" style="height: 40px;"/>
                                </a>
                            </div>
                        </div>

                        <!-- Links 1: Books -->
                        <div class="col-6 col-lg-2 ms-lg-auto">
                            <h5 class="text-white fw-bold mb-3 fs-6 text-uppercase" style="letter-spacing: 0.08em;">Books</h5>
                            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                                <li><a href="/shop">All Books</a></li>
                                <li><a href="/#how-it-works">How It Works</a></li>
                                <li><a href="/#choice-winners">Choice Winners</a></li>
                                <li><a href="/shop">New Releases</a></li>
                            </ul>
                        </div>

                        <!-- Links 2: Explore -->
                        <div class="col-6 col-lg-2">
                            <h5 class="text-white fw-bold mb-3 fs-6 text-uppercase" style="letter-spacing: 0.08em;">Explore</h5>
                            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                                <li><a href="/gifting">Gifting</a></li>
                                <li><a href="/faq">FAQ</a></li>
                                <li><a href="/contactus">Contact Us</a></li>
                                <li><a href="/web/login">Member Login</a></li>
                            </ul>
                        </div>

                        <!-- Newsletter -->
                        <div class="col-lg-3">
                            <h5 class="text-white fw-bold mb-3 fs-6 text-uppercase" style="letter-spacing: 0.08em;">Stay in the loop</h5>
                            <p class="text-white-50 small mb-3">Get monthly book drops, author hints, and exclusive announcements.</p>
                            <form action="/website/form/newsletter" method="post" class="d-flex flex-column gap-2">
                                <input type="email" class="form-control rounded-pill border-0 px-3 py-2 text-dark" placeholder="Enter your email" required="required"/>
                                <button type="submit" class="btn btn-warning rounded-pill fw-bold py-2 mt-1" style="background:#fff302; border:none; color:#080909;">Subscribe</button>
                            </form>
                        </div>
                    </div>

                    <div class="border-top border-secondary border-opacity-25 pt-4 mt-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                        <span class="text-white-50 small">© 2026 Aardvark Book Club. Unbox stories worth talking about.</span>
                        <div class="d-flex gap-4 small">
                            <a href="/privacy" class="text-white-50">Privacy Policy</a>
                            <a href="/terms" class="text-white-50">Terms of Service</a>
                            <a href="/contactus" class="text-white-50">Support</a>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
