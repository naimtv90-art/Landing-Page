<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="threadcraft_products_page" name="Threadcraft Products Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty tc-theme-wrapper">
                <!-- Hero Header -->
                <section class="py-5 tc-bg-charcoal text-white">
                    <div class="container py-5 text-center">
                        <span class="badge rounded-pill bg-light text-dark font-mono text-uppercase px-3 py-2 mb-3">Garment Silhouettes</span>
                        <h1 class="display-3 fw-bolder text-uppercase tc-font-syne max-w-900 mx-auto mb-4">
                            Precision Engineered <span class="tc-text-accent">Apparel</span>
                        </h1>
                        <p class="lead text-white-50 font-sans max-w-700 mx-auto">
                            From luxury heavyweight tees to technical outerwear, explore our master blanks and bespoke private-label silhouettes.
                        </p>
                    </div>
                </section>

                <t t-call="theme_threadcraft_garments.s_tc_3d_garment"/>
                <t t-call="theme_threadcraft_garments.s_tc_products"/>
                <t t-call="theme_threadcraft_garments.s_tc_partners"/>
                <t t-call="theme_threadcraft_garments.s_tc_cta"/>
            </div>
        </t>
    </template>
</odoo>
