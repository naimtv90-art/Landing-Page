<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="threadcraft_sustainability_page" name="Threadcraft Sustainability Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty tc-theme-wrapper">
                <!-- Hero Header -->
                <section class="py-5 tc-bg-charcoal text-white">
                    <div class="container py-5 text-center">
                        <span class="badge rounded-pill bg-success text-dark font-mono text-uppercase px-3 py-2 mb-3">Environmental Stewardship</span>
                        <h1 class="display-3 fw-bolder text-uppercase tc-font-syne max-w-900 mx-auto mb-4">
                            Circular <span class="tc-text-accent">Responsibility</span> at Scale
                        </h1>
                        <p class="lead text-white-50 font-sans max-w-700 mx-auto">
                            Pioneering zero-waste manufacturing: 100% Zero Liquid Discharge biological water recycling, 2.4 MW rooftop solar generation, and certified organic raw materials.
                        </p>
                    </div>
                </section>

                <t t-call="theme_threadcraft_garments.s_tc_sustainability"/>
                <t t-call="theme_threadcraft_garments.s_tc_stats"/>
                <t t-call="theme_threadcraft_garments.s_tc_quality"/>
                <t t-call="theme_threadcraft_garments.s_tc_cta"/>
            </div>
        </t>
    </template>
</odoo>
