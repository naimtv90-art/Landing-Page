                    <div class="aard-box-canvas-wrap position-relative text-center my-2 my-md-4">
                        <canvas id="aardvarkBoxCanvas" width="1920" height="1080" class="aard-box-canvas" title="Click or scroll to open/close the box!"></canvas>

