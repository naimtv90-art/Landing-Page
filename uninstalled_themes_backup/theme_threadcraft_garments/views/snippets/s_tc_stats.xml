<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_tc_stats" name="Threadcraft Manufacturing Stats">
        <section class="s_tc_stats oe_structure oe_empty py-5 border-top border-bottom border-secondary border-opacity-10" data-name="Threadcraft Manufacturing Stats">
            <div class="container py-4">
                <div class="row g-4 text-center">
                    <!-- Metric 1 -->
                    <div class="col-6 col-lg-3">
                        <div class="p-4 rounded-4 border bg-white h-100 shadow-sm tc-stat-card">
                            <div class="display-4 fw-bolder font-mono tc-counter mb-2 text-dark">
                                <span class="tc-counter-val" data-target="4.2">4.2</span><span class="tc-counter-suffix tc-text-accent">M</span>
                            </div>
                            <div class="h6 fw-bold text-uppercase font-sans mb-1">Monthly Production</div>
                            <div class="small text-muted font-mono">Finished garments across 42 high-efficiency sewing lines</div>
                        </div>
                    </div>

                    <!-- Metric 2 -->
                    <div class="col-6 col-lg-3">
                        <div class="p-4 rounded-4 border bg-white h-100 shadow-sm tc-stat-card">
                            <div class="display-4 fw-bolder font-mono tc-counter mb-2 text-dark">
                                <span class="tc-counter-val" data-target="99.4">99.4</span><span class="tc-counter-suffix tc-text-accent">%</span>
                            </div>
                            <div class="h6 fw-bold text-uppercase font-sans mb-1">First-Pass Yield</div>
                            <div class="small text-muted font-mono">Rigorous 7-step in-line QC meeting AQL 1.5 standard</div>
                        </div>
                    </div>

                    <!-- Metric 3 -->
                    <div class="col-6 col-lg-3">
                        <div class="p-4 rounded-4 border bg-white h-100 shadow-sm tc-stat-card">
                            <div class="display-4 fw-bolder font-mono tc-counter mb-2 text-dark">
                                <span class="tc-counter-val" data-target="38">38</span><span class="tc-counter-suffix tc-text-accent">+</span>
                            </div>
                            <div class="h6 fw-bold text-uppercase font-sans mb-1">Export Nations</div>
                            <div class="small text-muted font-mono">Direct container port dispatch to NA, EU, and APAC</div>
                        </div>
                    </div>

                    <!-- Metric 4 -->
                    <div class="col-6 col-lg-3">
                        <div class="p-4 rounded-4 border bg-white h-100 shadow-sm tc-stat-card">
                            <div class="display-4 fw-bolder font-mono tc-counter mb-2 text-dark">
                                <span class="tc-counter-val" data-target="100">100</span><span class="tc-counter-suffix tc-text-accent">%</span>
                            </div>
                            <div class="h6 fw-bold text-uppercase font-sans mb-1">ZLD Water Recycled</div>
                            <div class="small text-muted font-mono">Closed-loop biological effluent water treatment plant</div>
                        </div>
                    </div>
                </div>

                <!-- Accreditation Badges Strip -->
                <div class="mt-5 pt-4 border-top border-secondary border-opacity-10 text-center">
                    <div class="small font-mono text-uppercase text-muted mb-3">Global Compliance &amp; Ethical Audits</div>
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5 font-mono fw-bold text-muted opacity-75">
                        <span class="border px-3 py-1 rounded bg-light"><i class="fa fa-certificate me-1 tc-text-accent"/> OEKO-TEX Standard 100</span>
                        <span class="border px-3 py-1 rounded bg-light"><i class="fa fa-leaf me-1 text-success"/> GOTS Certified Organic</span>
                        <span class="border px-3 py-1 rounded bg-light"><i class="fa fa-shield me-1 text-primary"/> WRAP Gold Accredited</span>
                        <span class="border px-3 py-1 rounded bg-light"><i class="fa fa-check-circle me-1 text-info"/> Sedex SMETA 4-Pillar</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
