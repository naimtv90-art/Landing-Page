<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_garment_testimonials" name="Garment Testimonials">
        <section class="py-5 oe_snippet_body" data-name="Garment Testimonials">
            <div class="container py-4">
                <div class="s_garment_section_header">
