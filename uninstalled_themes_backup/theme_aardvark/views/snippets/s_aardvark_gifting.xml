<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_aardvark_gifting" name="Aardvark Gifting &amp; Press">
        <section class="s_aardvark_gifting" id="gifting">
            <div class="container py-lg-4">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <span class="u-handwritten fs-3 mb-2 d-inline-block">The ultimate present for bookworms</span>
                        <h2 class="u-heading-l mb-4">A gift outside of the box</h2>
                        <p class="fs-5 text-muted mb-4" style="line-height: 1.6;">
                            Gift a subscription and they can pick their own books. No spying on shelves needed. Order today and instantly receive an e-gift card to print out or forward. If you’re lucky, they might let you borrow a copy.
                        </p>
                        <a href="/gifting" class="aard-button-alt mb-5">
                            <span class="btn-pill-text">Shop gifts!</span>
                            <span class="btn-pill-arrow">➔</span>
                        </a>

                        <div class="pt-4 border-top">
                            <span class="u-handwritten fs-4 d-block mb-3">Mentioned by</span>
                            <div class="d-flex flex-wrap align-items-center gap-4">
                                <img src="/theme_aardvark/static/src/img/press-pw.webp" alt="Publishers Weekly" class="aard-press-logo"/>
                                <img src="/theme_aardvark/static/src/img/press-msnbc.webp" alt="MSNBC" class="aard-press-logo"/>
                                <img src="/theme_aardvark/static/src/img/press-bookriot.webp" alt="Book Riot" class="aard-press-logo"/>
                                <img src="/theme_aardvark/static/src/img/press-travel.webp" alt="Travel + Leisure" class="aard-press-logo"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 text-center">
                        <img src="/theme_aardvark/static/src/img/package-visual.webp" alt="Aardvark Gift Box" class="img-fluid" style="max-height: 480px; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.12));"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
